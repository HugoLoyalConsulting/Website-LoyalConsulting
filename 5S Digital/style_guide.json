      "glassmorphism",
      "neo-brutalist minimalism",
      "cinematic SaaS",
      "editorial futurism",
      "ambient gradients",
      "motion-centric UI"
    ],

    "shape_language": {
      "border_radius": {
        "cards": "24-36px",
        "buttons": "18-24px",
        "floating_elements": "pill-heavy"
      },

      "preferred_geometry": [
        "floating cards",
        "soft rounded rectangles",
        "large pills",
        "layered panels",
        "asymmetric compositions"
      ]
    }
  },

  "layout_architecture": {
    "global_structure": {
      "framework": "AIDA",
      "section_spacing": {
        "desktop": "py-32 to py-48",
        "mobile": "py-24"
      },
      "container_strategy": {
        "hero": "max-w-6xl",
        "content": "max-w-7xl",
        "text_blocks": "max-w-3xl",
        "avoid": [
          "narrow containers",
          "6-line headings",
          "compressed layouts"
        ]
      }
    },

    "hero_section": {
      "preferred_architecture": "Cinematic Center",
      "behavior": [
        "massive centered typography",
        "large negative space",
        "background ambient motion",
        "floating analytics cards",
        "subtle parallax"
      ],

      "mandatory_rules": [
        "headline maximum 2-3 lines",
        "no cheap badges",
        "no raw metrics",
        "no clutter"
      ]
    },

    "grid_system": {
      "type": "dense bento grid",
      "css_strategy": [
        "grid-auto-flow: dense",
        "asymmetrical spans",
        "mathematically filled layouts"
      ],

      "avoid": [
        "dead empty cells",
        "misaligned rows",
        "repetitive equal cards"
      ]
    }
  },

  "motion_system": {
    "global_motion_philosophy": [
      "everything subtly reacts",
      "motion guides hierarchy",
      "hover implies depth",
      "scroll reveals narrative"
    ],

    "hover_behavior": {
      "cards": [
        "scale 1.03-1.06",
        "soft upward translation",
        "glow intensification",
        "background gradient shift",
        "inner shadow bloom"
      ],

      "buttons": [
        "gradient movement",
        "ambient glow",
        "micro-scale effect"
      ],

      "dashboard_previews": [
        "3D tilt effect",
        "perspective rotation",
        "reflection movement"
      ]
    },

    "scroll_behavior": {
      "mandatory_effects": [
        "GSAP ScrollTrigger pinning",
        "scrub-based text reveal",
        "image scale progression",
        "stacking cards",
        "fade-depth transitions"
      ],

      "section_examples": {
        "services": "cards stack upward while scrolling",
        "case_studies": "left pinned text + scrolling dashboards",
        "metrics": "numbers animate progressively",
        "hero": "floating layered parallax"
      }
    },

    "micro_interactions": {
      "mandatory": [
        "button hover glow",
        "card magnetic movement",
        "cursor-aware highlights",
        "soft easing everywhere",
        "animated borders",
        "animated chart lines"
      ],

      "animation_timing": {
        "hover": "250-500ms",
        "page_motion": "600-1400ms",
        "easing": [
          "easeOutExpo",
          "cubic-bezier(0.22,1,0.36,1)"
        ]
      }
    }
  },

