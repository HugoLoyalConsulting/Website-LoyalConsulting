{
  "name": "loyal-consulting-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean:next": "node ./scripts/clean-next.mjs",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:stable": "next dev",
    "dev:clean": "npm run clean:next && next dev",
    "build": "next build",
    "build:static": "next build",
    "start": "next start",
    "start:cloud": "npm run db:migrate && next start -p ${PORT:-3000}",
    "db:migrate": "node ./scripts/migrate.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "next": "14.2.29",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/pg": "^8.20.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4"
  }
}
