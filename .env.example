# ── Backend (Railway) ────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/loyal
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# ── Frontend (build estático / GitHub Actions) ───────────────────
NEXT_PUBLIC_LEADS_ENDPOINT=/api/leads
NEXT_PUBLIC_TELEMETRY_ENDPOINT=/api/telemetry

# ── HubSpot (opcional — veja INTEGRATIONS.md) ────────────────────
# Tracking no site (variável HUBSPOT_PORTAL_ID no GitHub Actions):
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
# Encaminhamento de leads no backend (Railway). Modo 1 — Forms API (sem token):
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
# Modo 2 — Contacts API (token de Private App, escopo crm.objects.contacts.write):
HUBSPOT_ACCESS_TOKEN=
# Webhook genérico de CRM (já existia; qualquer URL que aceite POST JSON):
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Microsoft Clarity (opcional — veja INTEGRATIONS.md) ──────────
# Variável CLARITY_PROJECT_ID no GitHub Actions:
NEXT_PUBLIC_CLARITY_PROJECT_ID=
